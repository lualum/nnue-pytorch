+/* Ordered two-occupant slider-ray NNUE feature. */
+
+#ifndef NNUE_FEATURES_ORDERED_RAY_2_INCLUDED
+#define NNUE_FEATURES_ORDERED_RAY_2_INCLUDED
+
+#include <array>
+
+#include "../../misc.h"
+#include "../../types.h"
+#include "../nnue_common.h"
+
+namespace Stockfish {
+class Position;
+}
+
+namespace Stockfish::Eval::NNUE::Features {
+
+class OrderedRay2 {
+   public:
+    static constexpr u32 HashValue = 0xA8D12F37u;
+    static constexpr IndexType Dimensions = 2 * 16 * 12 * 12 * 3 * 3;
+    static constexpr IndexType IndexBase = 59808 + 4560;
+
+    using IndexList = ValueList<u32, 768>;
+    using Board = std::array<Piece, SQUARE_NB>;
+
+    static void append_active_indices(Color perspective, const Position& pos, IndexList& active);
+    static void append_changed_indices(Color perspective, Square ksq,
+                                       const DirtyRays& diff, IndexList& removed,
+                                       IndexList& added);
+};
+
+}  // namespace Stockfish::Eval::NNUE::Features
+
+#endif
